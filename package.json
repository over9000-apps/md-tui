{
  "name": "md-tui",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @md-tui/web dev",
    "test": "pnpm --filter @md-tui/web test",
    "build": "pnpm --filter @md-tui/web build",
    "preview": "pnpm --filter @md-tui/web preview",
    "deploy": "pnpm build && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.45.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd"]
  }
}
